#!/usr/bin/env python3
"""Check the proposed commit using a temporary checkout of the Git index."""

import os
import shutil
import subprocess
import sys
from pathlib import Path
from tempfile import TemporaryDirectory


def main() -> int:
    diff = subprocess.check_output([
        "git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACMRT",
        "--", "*.md", "*.py",
    ])
    paths = [os.fsdecode(path) for path in diff.split(b"\0") if path]
    if not paths:
        return 0

    with TemporaryDirectory() as snapshot:
        subprocess.run(["git", "checkout-index", "--all", f"--prefix={snapshot}/"], check=True)
        if any(path.endswith(".py") for path in paths):
            if not shutil.which("ruff"):
                print("pre-commit: install Ruff from requirements-dev.txt", file=sys.stderr)
                return 1
            result = subprocess.run(["ruff", "check", "scripts", "tools", "tests"], cwd=snapshot, check=False)
            if result.returncode:
                return result.returncode

        markdown = [path for path in paths if path.endswith(".md")]
        if markdown:
            checker = Path("scripts") / "check_markdown.py"
            return subprocess.run(
                [sys.executable, checker, "--strict", "--", *markdown], cwd=snapshot, check=False
            ).returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())
