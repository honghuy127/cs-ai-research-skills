#!/bin/sh
# Full offline suite, mirroring CI. Enable once per checkout:
#   git config core.hooksPath hooks
# Skip with: git push --no-verify
set -e

if ! command -v ruff >/dev/null 2>&1; then
    echo "pre-push: ruff not found; run: python3 -m pip install -r requirements-dev.txt" >&2
    exit 1
fi
if ! python3 -c "import pytest" >/dev/null 2>&1; then
    echo "pre-push: pytest not found; run: python3 -m pip install -r requirements-dev.txt" >&2
    exit 1
fi

ruff check scripts tools tests
python3 -m pytest tests/ -q
python3 scripts/check_markdown.py *.md references/*.md assets/*.md figures/*.md --strict
